{
  "requiresCompatibilities": ["FARGATE"],
  "family": "LearnJenkinsApp-TaskDefinition-Prod",
  "containerDefinitions": [
    {
      "name": "learnjenkinsapp",
      "image": "198200019683.dkr.ecr.ap-southeast-2.amazonaws.com/myjenkinsapp:#APP_VERSION#",
      "portMappings": [
        {
          "name": "nginx-80-tip",
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],

      "essential": true
    }
  ],
  "volumes": [],
  "networkMode": "awsvpc",
  "memory": "512",
  "cpu": "256",
  "executionRoleArn": "arn:aws:iam::198200019683:role/ecsTaskExecutionRole"
}
